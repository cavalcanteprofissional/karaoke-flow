# Copie este arquivo para .env.local e preencha com seus valores reais.
# Nunca commite o .env.local — ele está no .gitignore.

# ---- Supabase ----
# URL do projeto Supabase (Configurações > API)
NEXT_PUBLIC_SUPABASE_URL=
# Chave anônima/publishable do projeto (Configurações > API) — pública, usada no client
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service role — APENAS no servidor. Nunca exponha no client (nem prefixo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# ---- YouTube Data API ----
# Chave de API usada por padrão nas buscas. SOMENTE server-side (API route / server action).
# IMPORTANTE: não crie variável NEXT_PUBLIC_ para isso — a chave nunca deve ir ao client (spec seção 13).
YOUTUBE_API_KEY=
# OAuth do YouTube (opcional no MVP — necessário se o host autenticar conta própria)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# ---- Next.js ----
NEXT_PUBLIC_APP_URL=http://localhost:3000