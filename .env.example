# Copie este arquivo para .env.local e preencha com seus valores reais.
# Nunca commite o .env.local — ele está no .gitignore.

# ---- Supabase ----
# URL do projeto: https://<project-ref>.supabase.co (Configurações > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=
# Chave anon/publishable (Configurações > API > Project API keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role — APENAS no servidor. Nunca exponha no client (nem prefixo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
# Access token do Supabase CLI (Dashboard > Account > Access Tokens) — usado só em dev/CLI
SUPABASE_ACCESS_TOKEN=

# ---- YouTube Data API v3 ----
# Credencial tipo API key (Dados públicos) do Google Cloud, restrita à YouTube Data API v3.
# Usada no servidor (API route) — a chave nunca vai ao client (spec seção 13).
# Formato esperado: começa com "AIzaSy" (só você deve conhecer o valor completo).
YOUTUBE_API_KEY=
# OAuth do YouTube (opcional MVP — necessário se o host autenticar conta Google própria para cota,
# e usado em ferramentas dev). Client type: Web app (redirect http://localhost:3000/auth/youtube/callback
# — OAuth por-host) com redirect extra http://localhost:8891/ (coleta do token do app).
# JSON do Google fica em credentials/oauth/ (gitignored) — coloque aqui apenas os valores.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Refresh token da conta dev (fallback da busca — degrau 3 da cadeia). Coletado com node scripts/youtube-app-oauth.mjs
YOUTUBE_APP_REFRESH_TOKEN=

# ---- OAuth de login (providers) ----
# Credenciais dos OAuth apps criados nas plataformas (developer.spotify.com, github.com/settings/developers, etc.).
# Pasta duplicada nos painéis das plataformas e no dashboard do Supabase
# (Authentication > Providers). Apenas para consulta em dev — não usadas pelo app
# diretamente (as credenciais vivem no Supabase); o secret nunca vai ao client.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Seed de dev (scripts/seed.mjs) ----
# Usuários de teste criados/resolvidos pelo seed — SEMPRE pelo ID fixo, e a
# senha só vale na criação (usuário existente mantém a senha rotacionada).
# Os defaults abaixo são PÚBLICOS (documentados no README); coloque no seu
# .env.local os SEUS valores (nunca commitados). O seed/local e as envs da
# Vercel usam os mesmos valores para funcionar em produção/Cloud também.
SEED_HOST_EMAIL=dono@exemplo.com
SEED_HOST2_EMAIL=betania@exemplo.com
SEED_USER_EMAIL=ana@exemplo.com
SEED_USER2_EMAIL=bruno@exemplo.com
SEED_PASSWORD=senha123
# Form de e-mail/senha em produção. Default OFF. Só ligue com SENHAS PRIVADAS
# (a senha pública `senha123` deixa de valer no projeto Cloud). Em dev o form
# aparece sempre.
NEXT_PUBLIC_ENABLE_EMAIL_LOGIN=0

# ---- Next.js ----
NEXT_PUBLIC_APP_URL=http://localhost:3000