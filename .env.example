# Copie este arquivo para .env.local e preencha com seus valores reais.
# Nunca commite o .env.local — ele está no .gitignore.

# ---- Supabase ----
# URL do projeto Supabase (Configurações > API)
NEXT_PUBLIC_SUPABASE_URL=
# Chave anônima/publishable do projeto (Configurações > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service role — APENAS no servidor. Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- YouTube Data API ----
# Chave da API usada por padrão nas buscas (server-side apenas)
NEXT_PUBLIC_YOUTUBE_API_KEY=
YOUTUBE_API_KEY=
# OAuth do YouTube (opcional no MVP — necessário se o host autenticar conta própria)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# ---- Next.js ----
NEXT_PUBLIC_APP_URL=http://localhost:3000